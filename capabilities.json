{
  "privileges": [
    {
      "name": "WebAccess",
      "essential": false,
      "parameters": [
        "https://*",
        "http://*",
        "https://synoptic.design",
        "https://*.synoptic.design",
        "http://synoptic.design",
        "http://*.synoptic.design"
      ]
    }
  ],
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "Category",
      "kind": "Grouping"
    },
    {
      "displayName": "Subcategory",
      "name": "Series",
      "kind": "Grouping"
    },
    {
      "displayName": "Legend",
      "name": "Legend",
      "kind": "Grouping"
    },
    {
      "displayName": "Measure",
      "name": "Y",
      "kind": "Measure"
    },
    {
      "displayName": "Maps",
      "name": "MapSeries",
      "kind": "Grouping"
    },
    {
      "displayName": "Target",
      "name": "target",
      "kind": "Measure"
    },
    {
      "displayName": "States Measure",
      "name": "State",
      "kind": "Measure"
    },
    {
      "displayName": "States",
      "name": "states",
      "kind": "Measure"
    },
    {
      "displayName": "Tooltips",
      "name": "tooltips",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "Category": {
            "max": 1
          },
          "Series": {
            "max": 1
          },
          "Legend": {
            "max": 1
          },
          "Y": {
            "max": 1
          },
          "target": {
            "max": 1
          },
          "State": {
            "max": 1
          },
          "MapSeries": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "Category"
              }
            },
            {
              "for": {
                "in": "MapSeries"
              }
            },
            {
              "for": {
                "in": "Legend"
              }
            }
          ]
        },
        "values": {
          "group": {
            "by": "Series",
            "select": [
              {
                "bind": {
                  "to": "Y"
                }
              },
              {
                "bind": {
                  "to": "target"
                }
              },
              {
                "bind": {
                  "to": "State"
                }
              },
              {
                "bind": {
                  "to": "states"
                }
              },
              {
                "bind": {
                  "to": "tooltips"
                }
              }
            ]
          }
        }
      }
    }
  ],
